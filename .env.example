# Copy to .env for local development. Production values come from Key Vault-backed app settings.
# Keep comments on their own lines: after a value they become part of it.
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=on
DJANGO_ENV=local
DATABASE_URL=postgres://neurodb@127.0.0.1:5433/neurodb_v3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Beirut
ADMIN_URL_PATH=manage/
# Microsoft Entra ID (leave empty locally to use username/password login)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Upstream systems (service accounts; never commit real values)
ACTIVITYINFO_TOKEN=
# Or the ActivityInfo account's email and password (used instead of the token when both are set)
ACTIVITYINFO_USERNAME=
ACTIVITYINFO_PASSWORD=
ACTIVITYINFO_BASE_URL=https://www.activityinfo.org
ETOOLS_TOKEN=
ETOOLS_BASE_URL=https://etools.unicef.org
# eTools Datamart (the new eTools APIs, HTTP basic authentication): the nightly eTools sync
ETOOLS_USERNAME=
ETOOLS_PASSWORD=
ETOOLS_DATAMART_URL=https://datamart.unicef.io
ETOOLS_DATAMART_COUNTRY=Lebanon
# Years of partner progress reports kept (the PRP data is large)
ETOOLS_DATAMART_REPORTING_YEARS=3
# Business area code for the PRP datasets; found from the Datamart workspaces when empty
ETOOLS_DATAMART_BUSINESS_AREA=
# Youth figures from Compiler (counts only): base URL and the token of the NeuroDB service account
COMPILER_API_URL=
COMPILER_API_TOKEN=
# AI assistant ("Ask NeuroDB", OpenAI API: ChatGPT models). Empty key = assistant switched off.
# Project API key from platform.openai.com (never commit a real key).
OPENAI_API_KEY=
AI_ASSISTANT_MODEL=gpt-5.5
# Reasoning effort: none | minimal | low | medium | high | xhigh | max (support varies by model)
AI_ASSISTANT_EFFORT=medium
# Questions per user per hour
AI_ASSISTANT_HOURLY_LIMIT=30
# Tokens a day for all AI features together; background features stop using AI at 80% of it
AI_DAILY_TOKEN_SOFT_CAP=3000000
# Optional prices in USD per million tokens (input, cached input, output): the AI use list then shows costs
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_CACHED_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# NeuroDB Watch, the "For you" page (scheduled job "watch", 07:45; false: nothing runs)
WATCH_ENABLED=true
# Its AI: the morning notes and the look-ups (also needs the assistant on; false: plain wording only)
WATCH_AI=true
# Empty: the same model as AI_ASSISTANT_MODEL
WATCH_MODEL=
# Its AI limits a day: tokens (input + output) and model calls
WATCH_DAILY_TOKEN_CAP=300000
WATCH_MAX_MODEL_CALLS_PER_DAY=24
# The background look-up into open critical items (read-only tools), at most this many a day
WATCH_INVESTIGATE_ENABLED=true
WATCH_INVESTIGATE_PER_DAY=3
# After new data: wait this many seconds (a burst makes one pass), at most this many passes a day
WATCH_SETTLE_SECONDS=600
WATCH_QUICK_PASSES_PER_DAY=6
# A run stops between its steps after this many seconds
WATCH_TIME_LIMIT_SECONDS=900
# Per person and day: at most this many "Needs you" and "Good to know" items
WATCH_NEEDS_YOU_PER_DAY=5
WATCH_GOOD_TO_KNOW_PER_DAY=10
# Expiring grants are followed only with at least this much unspent (USD)
WATCH_GRANT_MIN_UNSPENT=10000
# One morning email per person instead of the What's new email, once EMAIL_URL is set
WATCH_EMAIL=true
# Monitoring insights (FMM)
# The eTools field monitoring visits and their quality; false: its refresh does nothing
FMM_ENABLED=true
# After every eTools Datamart sync: inline (in the sync's process), background (its own process) or off
FMM_REFRESH_AFTER_SYNC=inline
# Passes one refresh may make to serve the rescores asked for while it runs
FMM_REFRESH_MAX_PASSES=3
# Share of the records a key must fill to be chosen before the keys listed after it (0 to 1)
FMM_KEY_MIN_COVERAGE=0.5
# Visit page "Open in eTools": the activity address with {id} for its id; blank hides the link
FMM_ETOOLS_ACTIVITY_URL=
# Map: kilometres below which a visit and a planned location of its programme document are the same place
FMM_MATCH_KM=2.0
# Knowledge hub: months of visits added to it, and days within which a visit rated off track or constrained is news
FMM_HUB_MONTHS=24
FMM_NEWS_DAYS=30
# The AI brief and chat (off at deploy; also needs AI_ASSISTANT_ENABLED and a published prompt version)
FMM_AI=false
# Model of a prompt version that names none; empty: AI_ASSISTANT_MODEL
FMM_MODEL=
# auto: send temperature/top-p when set and not refused by the model; off: never send them
FMM_SAMPLING=auto
# Days after which a refused temperature/top-p is tried again
FMM_SAMPLING_RECHECK_DAYS=30
# Monitoring insights' own daily tokens and model calls for the whole office (raise AI_DAILY_TOKEN_SOFT_CAP with them)
FMM_DAILY_TOKEN_CAP=1200000
FMM_MAX_CALLS_PER_DAY=400
# Chat answers streaming at once on the whole site
FMM_CHAT_MAX_RUNNING=4
# Characters of each earlier chat answer re-sent with a follow-up question
FMM_HISTORY_ANSWER_CHARS=1500
# Nightly briefs: at most this many, and a section needs this many visits this year
FMM_NIGHTLY_MAX_INSIGHTS=12
FMM_NIGHTLY_MIN_VISITS=3
# No AI call for a filter with fewer visits
FMM_MIN_VISITS_FOR_AI=3
# Characters per text sent to the AI (narrative, answer, snippet)
FMM_NARRATIVE_CHARS=600
# Seconds per brief call
FMM_INSIGHTS_TIMEOUT_SECONDS=90
# Days after which a brief's sent payload is blanked, and after which briefs and chat questions are deleted
FMM_PAYLOAD_RETENTION_DAYS=30
FMM_RETENTION_DAYS=180
# The AI checks of the quality rules: their own tokens a day, and seconds per check
FMM_RULES_DAILY_TOKEN_CAP=2000000
FMM_RULES_TIMEOUT_SECONDS=60
# Azure Blob (optional locally; files stay on disk when empty)
AZURE_STORAGE_ACCOUNT=
# Leave the key empty in Azure: the managed identity is used
AZURE_STORAGE_KEY=
# Client id of the user-assigned identity (set by Bicep)
AZURE_CLIENT_ID=
AZURE_CONTAINER_MEDIA=media
# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
# plain locally, json in Azure
LOG_FORMAT=plain
# Container (defaults shown; Azure sets these through infra/main.bicep)
PORT=8000
# Apply migrations before the website starts
RUN_MIGRATIONS=true
WEB_CONCURRENCY=3
# The in-app scheduler (admin -> Scheduled jobs), run by the web workers; false: no job runs on a schedule
SCHEDULER_ENABLED=true
# Production/staging only; use disable for a local database
DB_SSLMODE=require
# Legacy tables: keep False in production (the database owns the schema); tests set True
# Public access: the landing page is always public. Optionally open safe pages without sign-in:
# comma-separated from library, maps, population (dashboards and reports always need sign-in).
PUBLIC_PAGES=
PUBLIC_LANDING_STATS=on
SUPPORT_EMAIL=
USER_GUIDE_URL=
# Knowledge hub: rebuild after each sync (and wait this many seconds so a burst of syncs makes one build)
KNOWLEDGE_HUB_ON_NEW_DATA=true
KNOWLEDGE_HUB_SETTLE_SECONDS=60
# Library and CPD documents are read into the knowledge base when saved
KNOWLEDGE_INDEX_ON_SAVE=true
# The daily what's new note by email (opt-in per person); empty EMAIL_URL: shown in NeuroDB only.
# The SMTP password is a secret: set it in the platform's secret store, not in this file.
EMAIL_URL=
DEFAULT_FROM_EMAIL=
# The address of this site, for the links in emails, e.g. https://neurodb.unicef.example
SITE_URL=
