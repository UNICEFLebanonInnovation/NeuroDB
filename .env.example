# Copy to .env for local development. Production values come from Key Vault-backed app settings.
# Keep comments on their own lines: after a value they become part of it.
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=on
DJANGO_ENV=local
DATABASE_URL=postgres://neurodb@127.0.0.1:5433/neurodb_v3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Beirut
ADMIN_URL_PATH=manage/
# Microsoft Entra ID (leave empty locally to use username/password login)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Upstream systems (service accounts; never commit real values)
ACTIVITYINFO_TOKEN=
# Or the ActivityInfo account's email and password (used instead of the token when both are set)
ACTIVITYINFO_USERNAME=
ACTIVITYINFO_PASSWORD=
ACTIVITYINFO_BASE_URL=https://www.activityinfo.org
ETOOLS_TOKEN=
ETOOLS_BASE_URL=https://etools.unicef.org
# eTools Datamart (the new eTools APIs, HTTP basic authentication): the nightly eTools sync
ETOOLS_USERNAME=
ETOOLS_PASSWORD=
ETOOLS_DATAMART_URL=https://datamart.unicef.io
ETOOLS_DATAMART_COUNTRY=Lebanon
# Years of partner progress reports kept (the PRP data is large)
ETOOLS_DATAMART_REPORTING_YEARS=3
# Business area code for the PRP datasets; found from the Datamart workspaces when empty
ETOOLS_DATAMART_BUSINESS_AREA=
# Youth figures from Compiler (counts only): base URL and the token of the NeuroDB service account
COMPILER_API_URL=
COMPILER_API_TOKEN=
# AI assistant ("Ask NeuroDB", OpenAI API: ChatGPT models). Empty key = assistant switched off.
# Project API key from platform.openai.com (never commit a real key).
OPENAI_API_KEY=
AI_ASSISTANT_MODEL=gpt-5.5
# Reasoning effort: none | minimal | low | medium | high | xhigh | max (support varies by model)
AI_ASSISTANT_EFFORT=medium
# Questions per user per hour
AI_ASSISTANT_HOURLY_LIMIT=30
# Azure Blob (optional locally; files stay on disk when empty)
AZURE_STORAGE_ACCOUNT=
# Leave the key empty in Azure: the managed identity is used
AZURE_STORAGE_KEY=
# Client id of the user-assigned identity (set by Bicep)
AZURE_CLIENT_ID=
AZURE_CONTAINER_MEDIA=media
# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
# plain locally, json in Azure
LOG_FORMAT=plain
# Container (defaults shown; Azure sets these through infra/main.bicep)
PORT=8000
# Apply migrations before the website starts
RUN_MIGRATIONS=true
WEB_CONCURRENCY=3
# The in-app scheduler (admin -> Scheduled jobs), run by the web workers; false: no job runs on a schedule
SCHEDULER_ENABLED=true
# Production/staging only; use disable for a local database
DB_SSLMODE=require
# Legacy tables: keep False in production (the database owns the schema); tests set True
# Public access: the landing page is always public. Optionally open safe pages without sign-in:
# comma-separated from library, maps, population (dashboards and reports always need sign-in).
PUBLIC_PAGES=
PUBLIC_LANDING_STATS=on
SUPPORT_EMAIL=
USER_GUIDE_URL=
# Knowledge hub: rebuild after each sync (and wait this many seconds so a burst of syncs makes one build)
KNOWLEDGE_HUB_ON_NEW_DATA=true
KNOWLEDGE_HUB_SETTLE_SECONDS=60
# Library and CPD documents are read into the knowledge base when saved
KNOWLEDGE_INDEX_ON_SAVE=true
# The daily what's new note by email (opt-in per person); empty EMAIL_URL: shown in NeuroDB only.
# The SMTP password is a secret: set it in the platform's secret store, not in this file.
EMAIL_URL=
DEFAULT_FROM_EMAIL=
# The address of this site, for the links in emails, e.g. https://neurodb.unicef.example
SITE_URL=
